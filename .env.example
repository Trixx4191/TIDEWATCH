# Copy to .env and fill in as needed. Never commit .env or share it.

# ── Data sources ────────────────────────────────────────────────────────────
# Census Data API key (free: https://api.census.gov/data/key_signup.html).
# Needed for ACS income, poverty and age. Without it, 2020 population and
# housing counts still load, but the equity figures are unavailable.
CENSUS_API_KEY=
# Optional NOAA CO-OPS token (higher rate limits). Other sources are public.
NOAA_API_KEY=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# Comma-separated allowlist; leave empty for same-origin only.
CORS_ORIGINS=

# ── Data operations from the dashboard (Data panel) ─────────────────────────
# Mode A (local): "auto" enables builds for requests from this computer
# (loopback) when NODE_ENV is not "production". "true" forces it on, "false" off.
TIDEWATCH_LOCAL_BUILDS=auto
# Mode B (deployment): admins sign in with this token (≥ 16 characters).
# Leave empty on a public read-only deployment.
TIDEWATCH_ADMIN_TOKEN=
# Python interpreter used for jobs (default python3, or python on Windows).
# TIDEWATCH_PYTHON=/usr/bin/python3

# ── Folders ─────────────────────────────────────────────────────────────────
# Where the API reads processed datasets (default: data/processed)
# TIDEWATCH_DATA_DIR=/path/to/processed
# Where the pipeline caches raw downloads (default: data/raw)
# TIDEWATCH_RAW_DIR=/path/to/raw-cache
# Where exported/uploaded dataset packages are kept (default: data/packages)
# TIDEWATCH_PACKAGES_DIR=/path/to/packages
